<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · Didymus — Early Christian Spirituality and Spiritual Direction</title>
<meta name="description" content="{{ description or title }}">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
{% import "nav.njk" as navmacro %}
<header class="site-header">
  <a class="site-title-wrap" href="/">
    <img class="site-logo" src="/img/header.jpg" alt="Didymus">
    <span class="site-title">Didymus</span>
  </a>
  <p class="site-subtitle">Early Christian Spirituality and Spiritual Direction</p>
  <nav class="site-nav">
    <ul class="nav-tree">
    {% for item in nav %}{{ navmacro.navitem(item) }}{% endfor %}
      <li><a href="/sitemap/">All Pages</a></li>
    </ul>
  </nav>
  <div class="site-search" data-base-url="{{ site.baseUrl }}">
    <input type="search" id="site-search-input" placeholder="Search site&hellip;" autocomplete="off">
    <ul id="site-search-results" hidden></ul>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<script src="/js/search.js"></script>
</body>
</html>
