---
layout: base.njk
---
<article>
  <div class="prose"><h1>{{ title }}</h1></div>
  {% for a in attachments %}{% if a.url.endsWith(".pdf") %}
  <div class="pdf-viewer-wrap">
    <div class="pdf-viewer">
      <iframe src="{{ a.url }}#toolbar=1" title="{{ a.file }}" loading="lazy"></iframe>
    </div>
    <p class="pdf-viewer-fallback"><a href="{{ a.url }}" target="_blank" rel="noopener">Open in a new tab</a> or <a href="{{ a.url }}" download>download {{ a.file }}</a> if the preview above doesn't load.</p>
  </div>
  {% endif %}{% endfor %}
  <div class="prose">
  {{ content | safe }}
  {% if attachments and attachments.length %}
  <div class="attachments">
    <h2>Files</h2>
    <ul>
    {% for a in attachments %}
      <li><a href="{{ a.url }}" download>{{ a.file }}</a></li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% set children = collections.childrenBySlug[slug] %}
  {% if children and children.length %}
  <div class="section-index">
    <h2>In This Section</h2>
    <ul class="page-list">
    {% for c in children %}
      <li><a href="/{{ c.slug }}/">{{ c.title }}</a></li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}
  </div>
</article>
